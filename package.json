{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run vendor && node scripts/package-site.js",
    "test": "node --test scripts/package-site.test.js && python3 -m unittest discover -s scripts -p 'test_*.py'",
    "deploy:tecnico": ".venv/bin/ansible-playbook -i localhost, deploy/tecnico.yml",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1 --directory dist",
    "build:css": "sass --load-path=node_modules --no-source-map --style=compressed --quiet-deps --silence-deprecation=import scss/main.scss css/main.css",
    "watch:css": "sass --load-path=node_modules --no-source-map --style=compressed --quiet-deps --silence-deprecation=import --watch scss/main.scss css/main.css",
    "vendor": "node scripts/vendor.js"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "sass": "^1.106.1"
  }
}
